{
  "$schema": "https://railway.com/railway.schema.json",
  "build": { "builder": "DOCKERFILE", "dockerfilePath": "Dockerfile" },
  "deploy": {
    "startCommand": "celery -A app.workers.celery_app:celery_app worker -B --schedule=/tmp/celerybeat-schedule --loglevel=INFO --concurrency=2",
    "restartPolicyType": "ALWAYS"
  }
}
