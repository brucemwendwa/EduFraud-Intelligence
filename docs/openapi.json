  "components": {
    "schemas": {
      "AuditCategory": {
        "type": "string",
        "enum": [
          "authentication",
          "verification",
          "investigation",
          "permission",
          "data_access",
          "detection",
          "disbursement",
          "application",
          "system"
        ],
        "title": "AuditCategory"
      },
      "AuditEventOut": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "sequence": {
            "type": "integer",
            "title": "Sequence"
          },
          "organization_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Organization Id"
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time",
            "title": "Occurred At"
          },
          "actor_user_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Actor User Id"
          },
          "actor_email": {
