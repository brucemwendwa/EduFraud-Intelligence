              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Actor Email"
          },
          "actor_role": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Actor Role"
          },
          "category": {
            "type": "string",
            "title": "Category"
          },
          "action": {
            "type": "string",
            "title": "Action"
          },
          "outcome": {
            "type": "string",
            "title": "Outcome"
          },
          "target_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Target Type"
          },
          "target_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Target Id"
          },
          "target_ref": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Target Ref"
          },
          "details": {
            "additionalProperties": true,
            "type": "object",
            "title": "Details"
          },
          "hash": {
            "type": "string",
            "title": "Hash"
          },
          "prev_hash": {
            "type": "string",
            "title": "Prev Hash"
          }
        },
        "type": "object",
        "required": [
          "id",
          "sequence",
          "organization_id",
          "occurred_at",
          "actor_user_id",
          "actor_email",
          "actor_role",
          "category",
          "action",
          "outcome",
          "target_type",
          "target_id",
          "target_ref",
          "details",
          "hash",
          "prev_hash"
        ],
        "title": "AuditEventOut"
      },
      "AuditOutcome": {
        "type": "string",
        "enum": [
          "success",
          "failure",
          "denied"
        ],
        "title": "AuditOutcome"
      },
      "AuditSummary": {
        "properties": {
          "total_events": {
            "type": "integer",
            "title": "Total Events"
          },
          "by_category": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "By Category"
          },
          "denied_last_7_days": {
            "type": "integer",
            "title": "Denied Last 7 Days"
          },
          "failed_logins_last_7_days": {
            "type": "integer",
            "title": "Failed Logins Last 7 Days"
          }
        },
        "type": "object",
        "required": [
          "total_events",
          "by_category",
          "denied_last_7_days",
          "failed_logins_last_7_days"
        ],
        "title": "AuditSummary"
      },
