# EduShield AI — environment configuration example.
# Copy to `backend/.env` for local development (settings are read from the backend directory).
# NEVER commit real secrets. All values below are development placeholders.

# --- Runtime ---------------------------------------------------------------
ENV=development                 # development | test | production
DEMO_MODE=false                 # opt in only for an isolated local synthetic-data demonstration

# --- Database --------------------------------------------------------------
# SQLite is the zero-setup default for local runs and tests.
# PostgreSQL is the production target (ENV=production refuses SQLite).
DATABASE_URL=sqlite:///./var/edushield.db
# DATABASE_URL=postgresql+psycopg://edushield:edushield@localhost:5432/edushield

# --- Background jobs -------------------------------------------------------
# Leave empty to run detection jobs inline (no Redis required).
CELERY_BROKER_URL=
# CELERY_BROKER_URL=redis://localhost:6379/0

# --- Secrets (generate your own for any shared environment) ---------------
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-jwt-secret-for-local-development-only
# Keyed pseudonymization (HMAC-SHA256) of identity attributes.
TOKENIZATION_KEY=change-me-tokenization-key-for-local-development
# Fernet key for field-level encryption of revealable PII.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEY=
# HMAC secret the payment/identity provider uses to sign event webhooks (sandbox in this prototype).
PROVIDER_WEBHOOK_SECRET=change-me-sandbox-provider-webhook-secret

# --- Account risk engine ---------------------------------------------------
# Optional JSON object overriding rule weights (0-0.99), e.g. {"NEW_DEVICE": 0.05, "SPENDING_SPIKE": 0.3}
ACCOUNT_RISK_WEIGHTS=

# --- HTTP ------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173
ACCESS_TOKEN_TTL_MINUTES=60
# Directory of the built web client, to serve it from the API's own origin (set in the container image).
FRONTEND_DIST=

# --- Student account activation -------------------------------------------
STUDENT_INVITATION_TTL_HOURS=72
STUDENT_ACTIVATION_BASE_URL=http://localhost:5173/activate
# Development delivery never sends email; it returns an activation URL only to an authorized staff caller.
# Production requires SMTP configuration and never exposes the URL in API responses.
EMAIL_PROVIDER=development
EMAIL_FROM=no-reply@edushield.local
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# --- Private supporting-document storage -----------------------------------
# Configure an S3-compatible private bucket (MinIO may be used locally). Production refuses to start without these.
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_USE_TLS=true
S3_ADDRESSING_STYLE=auto
S3_PRESIGNED_URL_TTL_SECONDS=300
DOCUMENT_MAX_UPLOAD_BYTES=10485760
# No scanner is bundled. Uploaded files remain quarantined and unavailable until a scanner is configured.
# Use clamav with a private clamd daemon: its TCP port is unauthenticated.
DOCUMENT_SCANNER_PROVIDER=unconfigured
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=60
DOCUMENT_SCAN_MAX_ATTEMPTS=3
DOCUMENT_SCAN_LEASE_SECONDS=900
DOCUMENT_SCAN_RETRY_BASE_SECONDS=60
